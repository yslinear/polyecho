// PolyEcho — Tailscale ACL example (HuJSON format)
// Restrict access to the PolyEcho node to your own devices only.
// Replace <your-tailnet>.ts.net and tagged device names with your real values.
// Apply at: https://login.tailscale.com/admin/acls
{
  // Define groups
  "groups": {
    // All of Shan's personal devices (Mac + iPhone)
    "group:shan-devices": [
      "yslinear@gmail.com"
    ]
  },

  // Tag definitions — tag the PolyEcho host
  "tagOwners": {
    "tag:polyecho-server": ["yslinear@gmail.com"]
  },

  // ACL rules: only Shan's devices can reach the PolyEcho server
  "acls": [
    {
      "action": "accept",
      "src":    ["group:shan-devices"],
      "dst":    ["tag:polyecho-server:443", "tag:polyecho-server:22"]
    }
  ],

  // SSH access: Shan can SSH into the PolyEcho server
  "ssh": [
    {
      "action": "accept",
      "src":    ["group:shan-devices"],
      "dst":    ["tag:polyecho-server"],
      "users":  ["autogroup:nonroot"]
    }
  ]
}
