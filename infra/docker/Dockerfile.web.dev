# PolyEcho — Next.js development image (hot-reload)
# Used by docker-compose.dev.yml web service override.
# packages/web is bind-mounted at runtime so changes are reflected instantly.

ARG NODE_VERSION=22

# Base image is digest-pinned (@sha256:) for supply-chain integrity: the human
# tag stays for readability, the digest makes the pull reproducible and
# tamper-evident (same digest as Dockerfile.web). Both the tag and the
# @sha256: digest are bumped automatically by renovate/dependabot.
FROM node:${NODE_VERSION}-bookworm-slim@sha256:689c11043dad91472750cd824c97dd5e2318e9dd6f954e492fe7af0135d33ceb

RUN corepack enable

WORKDIR /workspace

# Copy workspace manifests only (source is bind-mounted)
COPY package.json pnpm-workspace.yaml ./
COPY packages/web/package.json packages/web/package.json

RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["pnpm", "--filter", "@polyecho/web", "dev"]
