# PolyEcho — CLI image
# Same multi-stage Python/uv base as Dockerfile.python, but entrypoint is the
# `polyecho` console script (installed by polyecho-cli package).
# Usage:
#   docker compose -f infra/docker-compose.yml run --rm cli polyecho doctor
#   docker compose -f infra/docker-compose.yml run --rm cli polyecho account list

ARG PYTHON_VERSION=3.12
ARG UV_VERSION=0.5

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python${PYTHON_VERSION}-bookworm-slim AS builder

# Build under the SAME path used at runtime (/app). `uv sync` installs the
# uv-workspace members as EDITABLE installs whose .pth entries hard-code the
# absolute src path; a /build builder + /app runtime dangles the `polyecho`
# namespace and the `polyecho` console script (same class as Dockerfile.python).
WORKDIR /app

COPY pyproject.toml ./
COPY uv.lock* ./

COPY packages/shared/pyproject.toml   packages/shared/pyproject.toml
COPY packages/core/pyproject.toml     packages/core/pyproject.toml
COPY packages/discovery/pyproject.toml packages/discovery/pyproject.toml
COPY packages/backtest/pyproject.toml packages/backtest/pyproject.toml
COPY packages/push/pyproject.toml     packages/push/pyproject.toml
COPY packages/cli/pyproject.toml      packages/cli/pyproject.toml

COPY packages/shared/src   packages/shared/src
COPY packages/core/src     packages/core/src
COPY packages/discovery/src packages/discovery/src
COPY packages/backtest/src packages/backtest/src
COPY packages/push/src     packages/push/src
COPY packages/cli/src      packages/cli/src

RUN if [ -f uv.lock ]; then \
        uv sync --frozen --no-dev; \
    else \
        uv sync --no-dev; \
    fi

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

# Non-root user (PRD §7.2)
RUN groupadd --gid 1001 polyecho && \
    useradd  --uid 1001 --gid polyecho --no-create-home --shell /sbin/nologin polyecho

# postgresql-client provides pg_dump / pg_isready for `polyecho db backup`
# (PRD §7.3) and migrate health checks. Slim install, apt lists cleaned.
RUN apt-get update && \
    apt-get install --no-install-recommends -y postgresql-client && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages

ENV PATH="/app/.venv/bin:$PATH"
# Belt-and-suspenders: expose every package src so the PEP 420 `polyecho`
# namespace resolves even if the editable finder is unhappy after the copy.
ENV PYTHONPATH="/app/packages/shared/src:/app/packages/core/src:/app/packages/discovery/src:/app/packages/backtest/src:/app/packages/push/src:/app/packages/cli/src"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER polyecho

# The `polyecho` console script is installed by polyecho-cli into the venv bin.
ENTRYPOINT ["polyecho"]
CMD ["--help"]
