# PolyEcho environment — copy to .env and fill in. NEVER commit .env.
# Env var prefix per PRD §0: POLYECHO_

# --- Database (Postgres 16) ---
POLYECHO_DB_URL=postgresql+asyncpg://polyecho:polyecho@localhost:5432/polyecho
# Drizzle (web) uses a sync driver URL:
POLYECHO_DB_URL_DRIZZLE=postgresql://polyecho:polyecho@localhost:5432/polyecho

# --- Polymarket ---
POLYECHO_POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYECHO_POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYECHO_POLYGON_RPC_URL=https://polygon-rpc.com
POLYECHO_POLYMARKET_CHAIN_ID=137
# Optional outbound proxy for ALL Polymarket API calls (geo-block workaround,
# PRD §8.1). http://[user:pass@]host:port (https:// ok; socks5:// needs
# httpx[socks], not bundled). Blank = direct. The web /settings page writes
# the `settings` DB row 'polymarket_proxy_url' which overrides this at runtime.
POLYECHO_POLYMARKET_PROXY_URL=

# --- Account / key encryption (CLI only; never read by web process) ---
# Passphrase is entered interactively by the CLI, NOT stored here.
POLYECHO_KEY_KDF_ITERATIONS=600000

# --- Web Push (VAPID, RFC 8292) ---
POLYECHO_VAPID_PUBLIC_KEY=
POLYECHO_VAPID_PRIVATE_KEY=
POLYECHO_VAPID_SUBJECT=mailto:admin@example.com

# --- Live trading — Phase-4 HARD safety lock (brief §9) ---
# DANGER: POLYECHO_LIVE_TRADING is the MASTER live-money lock. While unset
# or false (the default), every CLOB order and on-chain redeem RAISES at
# the single chokepoint (copytrading.assert_live_allowed). Set to true ONLY
# when you intend to place real orders / move real funds. Leave commented.
#POLYECHO_LIVE_TRADING=false
# Auto claim-winnings / redeem. Still gated by the live lock above; only
# acts when BOTH this and POLYECHO_LIVE_TRADING are true. Leave commented.
#POLYECHO_AUTO_REDEEM=false

# --- Web dashboard ---
POLYECHO_WEB_PORT=3000
# Operator-opt-in CSRF allow-list extension (PRD §5.9). Comma-separated list
# of ABSOLUTE origins, e.g.:
#   POLYECHO_WEB_ALLOWED_ORIGINS=http://mac-mini.tail3e1efb.ts.net:3006
# By default the dashboard's mutating Server Actions (queue backtest, save
# proxy, pause leader, ack danger) are accepted ONLY from a localhost /
# 127.0.0.1 Origin. SECURITY: setting this WIDENS that localhost-only CSRF
# allow-list to every origin listed here — the no-auth dashboard then
# becomes fully ACTION-CAPABLE from those origins. Set this ONLY to origins
# you control on your own tailnet (it is the natural companion to publishing
# the dashboard on 0.0.0.0:3006 for Tailscale access). Blank/unset = secure
# default, localhost-only.
#POLYECHO_WEB_ALLOWED_ORIGINS=

# --- Ops ---
POLYECHO_LOG_LEVEL=INFO
POLYECHO_TZ=Asia/Taipei
