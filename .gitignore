# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Tests / coverage artifacts
.coverage
.coverage.*
coverage/
htmlcov/
*.lcov
.vitest/

# uv
# NOTE: uv.lock IS committed — this is an application monorepo and the lockfile
# is required for reproducible CI (uv sync --frozen) and the setup-uv cache.

# Node / Next.js
node_modules/
packages/web/.next/
packages/web/out/
packages/web/next-env.d.ts
.pnpm-store/

# Env & secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
secrets/

# Database & backups
*.sqlite
*.sqlite3
backups/
pgdata/

# Logs
*.log
logs/

# OS / editors / iCloud
.DS_Store
.AppleDouble
.LSOverride
Icon?
# The macOS "Icon?" rule above also matches the web PWA asset directory
# `packages/web/public/icons/` (case-insensitive: Icon? -> icon s). Those
# committed PWA icons are real project assets, so re-include them explicitly.
!packages/web/public/icons/
!packages/web/public/icons/**
.idea/
.vscode/
*.swp
