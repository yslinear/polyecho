# uv
# NOTE: uv.lock IS committed — this is an application monorepo and the lockfile
# is required for reproducible CI (uv sync --frozen) and the setup-uv cache.

# Node / Next.js
node_modules/
packages/web/.next/
packages/web/out/
packages/web/next-env.d.ts
.pnpm-store/

# Env & secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
secrets/

# Database & backups
*.sqlite
*.sqlite3
backups/
pgdata/

# Logs
*.log
logs/

